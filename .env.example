# ---- App ----
APP_ENV=development
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Postgres ----
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker
POSTGRES_PORT=5432
# From your machine (go run): host is localhost
# Inside Docker (Phase 4): host becomes "postgres"
DATABASE_URL=postgres://tracker:change-me@localhost:5432/tracker?sslmode=disable

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Supabase Auth (Phase 6) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ---- Scraper (Phase 5) ----
SCRAPER_USER_AGENT="InternshipTracker/0.1 (user-requested URL extraction)"
SCRAPER_TIMEOUT_SECONDS=10
